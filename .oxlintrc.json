{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "src/wasm.ts"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
